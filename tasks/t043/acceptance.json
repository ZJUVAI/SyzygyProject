  "source_review": {
    "definition": "固定F2七维空间中的三维线性子空间，任意两子空间交维数≤1，即子空间距离≥4，最大化子空间数量。",
    "primary_reconstruction": "亲自解析Heinlein等arXiv1708.06224v5附录B/C：逐字匹配103个代表的721个数字和两个7×7生成矩阵的98个位。核对列编码a+2b+4c与轨道1^9 2^26 4^68，展开得到333个不同三维子空间。v5为2019-03-22，首版2017。",
    "current_open_status": "主代理查询官方MIPLIB当前索引：cdc7-4-3-2状态open，所列同参数界333–381，2026-08-28记录回引2019人类ILP文献。2025综述的378或381仅是条件替代，未误写成无条件378。",
    "independent_verification": "逐子空间用异或闭包检查8元素，再独立枚举其中7个二维子空间；全局无重复二维子空间。333构造共2331个不同二维子空间。环境共有127*126/6=2667个，故上界381。正式检查器另按55278个子空间对检查交大小。",
    "controls": "五种程序、故意相交二维子空间的破坏样例、整个验证结果不受声明成绩影响、严格回放、冷导出及程序错误/非有限数/超时检查全部通过。初始1，传统搜索230，演化227，公开与人类参考333。",
    "limits": "复现文献可行构造，未重做原始完整ILP搜索，未证明333最优。"
  }
}
